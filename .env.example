# Copy this file to .env and fill it in. Never share or commit .env.

# PayPal sandbox credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Set to 1 to run fully offline with a clearly-labelled PayPal MOCK (dev only, never for the demo video)
PAYPAL_MOCK=0

# AI auditor. Fill in ONE key. With no key, a keyword matcher is used (dev only).
# Free option: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check the current free model names in Google AI Studio if this one is rejected
GEMINI_MODEL=gemini-3.8-flash

# Paid option: Claude (Anthropic API)
ANTHROPIC_API_KEY=
AUDITOR_MODEL=claude-sonnet-5-5

# Force a provider if you set both keys: gemini or anthropic (optional)
AI_PROVIDER=

# Public address of this app, used for PayPal return links.
# Leave BLANK on GitHub Codespaces and Render: it is detected automatically.
# Only set it if you host the app somewhere else, for example https://proofpay.example.com
APP_BASE_URL=
PORT=3000
